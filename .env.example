# Local dev config for bin/dev: `cp .env.example .env`. State lives under the
# gitignored .local/ (bin/dev creates it), so no sudo or /var/lib is needed.
# Production defaults (/var/lib/mcp-ssh/...) apply when these are unset.

# Address the server binds to.
MCP_SSH_BIND=127.0.0.1:1337
# Override just the port of MCP_SSH_BIND.
# MCP_SSH_PORT=1337

# Credentials for MCP auth.
MCP_SSH_USER=admin
MCP_SSH_PASS=change-me

# Commands finishing within this many seconds return inline; longer ones become jobs.
MCP_SSH_INLINE_TIMEOUT_SECS=2

# Where background job output is stored.
MCP_SSH_JOB_DIR=.local/jobs

# SQLite DB: OAuth tokens, registered clients, job history.
MCP_SSH_DB=.local/mcp-ssh.db

# Comma-separated hosts allowed to connect.
MCP_SSH_ALLOWED_HOSTS=localhost,127.0.0.1

# Public origin clients reach (behind the TLS proxy); the OAuth issuer URL.
# MCP_SSH_PUBLIC_URL=https://your-host.example.com

# Logging.
RUST_LOG=info,mcp_ssh=debug

# GlitchTip error tracking. Unset/empty SENTRY_DSN ⇒ disabled (no-op client).
# Injected at runtime via the systemd EnvironmentFile, not committed.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
