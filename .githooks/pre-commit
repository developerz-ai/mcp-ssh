#!/usr/bin/env bash
# Pre-commit gate. CI still grades coverage deferred by a partial local grade.
# ACTIVATE IT (once, per clone): git config core.hooksPath .githooks
set -euo pipefail
cd "$(dirname "$0")/.."
status=0
bin/check || status=$?
if [[ $status == 79 ]]; then
  echo "pre-commit: partial grade accepted; CI grades deferred coverage" >&2
  exit 0
fi
exit "$status"
