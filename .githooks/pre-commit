#!/usr/bin/env bash
# pre-commit gate — established by the developerz.ai maintainer agent for the maintainers of this repository. Runs the SAME
# `bin/check` CI runs, so a commit that would fail CI fails here first.
# ACTIVATE IT (once, per clone): git config core.hooksPath .githooks
set -euo pipefail
cd "$(dirname "$0")/.."

# bin/check's exit contract: 0 = green, 79 = everything it could run passed and
# CI grades the rest — both commit. 75 = the environment could not run the gate,
# 1 = the change is red — both block.
status=0
bin/check || status=$?
case "$status" in
  0) exit 0 ;;
  79)
    echo "pre-commit: bin/check could not grade everything here (exit 79) — committing; CI grades the rest." >&2
    exit 0
    ;;
  75)
    echo "pre-commit: bin/check could not run here (exit 75) — the environment is at fault, not this change." >&2
    exit 75
    ;;
  *)
    echo "pre-commit: bin/check failed (exit $status) — this change is red." >&2
    exit "$status"
    ;;
esac
