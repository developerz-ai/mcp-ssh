#!/usr/bin/env bash
# Mint an OAuth 2.1 bearer token from a running mcp-ssh server and print it to stdout.
#
# `/mcp` is bearer-only: GUI clients (Claude desktop/web) run the browser OAuth
# flow automatically, but a headless client — the `claude` CLI, curl, a script —
# has no browser. This runs the same Authorization-Code + PKCE flow non-interactively
# so you can hand the token to such a client:
#
#   claude mcp add --transport http mcp-ssh http://localhost:1337/mcp \
#     --header "Authorization: Bearer $(bin/mcp-token)"
#
# Credentials come from the app's .env (apps/mcp-ssh/.env; MCP_SSH_USER/MCP_SSH_PASS) or the environment.
# The base URL defaults to the local bind; override with $MCP_SSH_URL.
# The access token lasts 24h and survives server restarts (tokens are stored,
# hashed, in the server's SQLite). Only the access token is printed — the 30-day
# refresh token in the response is discarded — so re-run this to get a new one.
# Each run is a separate login (and a registered client, swept once it is 7+ days
# old and holds no live token); `mcp-ssh sessions --revoke` on the host ends every login.
set -euo pipefail

cd "$(dirname "$0")/.."

# The app's .env lives at apps/mcp-ssh/.env; older checkouts keep one at the repo root.
if [ -f apps/mcp-ssh/.env ]; then
  set -a
  # shellcheck disable=SC1091
  . apps/mcp-ssh/.env
  set +a
elif [ -f .env ]; then
  set -a
  # shellcheck disable=SC1091
  . ./.env
  set +a
fi

: "${MCP_SSH_USER:?set MCP_SSH_USER (or put it in .env)}"
: "${MCP_SSH_PASS:?set MCP_SSH_PASS (or put it in .env)}"
BASE="${MCP_SSH_URL:-http://${MCP_SSH_BIND:-127.0.0.1:1337}}"
REDIRECT="http://localhost/cb"

for bin in curl openssl sed grep; do
  command -v "$bin" >/dev/null || { echo "mcp-token: '$bin' not found" >&2; exit 1; }
done

# PKCE: random verifier, S256 challenge = BASE64URL(SHA256(verifier)).
verifier=$(openssl rand -base64 60 | tr -d '\n=+/' | cut -c1-64)
challenge=$(printf '%s' "$verifier" | openssl dgst -binary -sha256 | openssl base64 | tr '+/' '-_' | tr -d '=\n')

# /register — Dynamic Client Registration (RFC 7591). /authorize binds the auth
# code's destination to the redirect URIs a client registered, so mint a client_id
# for $REDIRECT before starting the flow.
client_id=$(curl -fsS -X POST "$BASE/register" \
  -H 'Content-Type: application/json' \
  -d "{\"redirect_uris\":[\"$REDIRECT\"]}" \
  | sed -n 's/.*"client_id":"\([^"]*\)".*/\1/p')
[ -n "$client_id" ] || { echo "mcp-token: client registration failed (server down?)" >&2; exit 1; }

# GET /authorize — validates the request and serves the consent form; never a
# code. The form carries a single-use csrf_token naming this request server-side.
csrf=$(curl -fsS -G "$BASE/authorize" \
  --data-urlencode "response_type=code" \
  --data-urlencode "client_id=$client_id" \
  --data-urlencode "redirect_uri=$REDIRECT" \
  --data-urlencode "code_challenge=$challenge" \
  --data-urlencode "code_challenge_method=S256" \
  | grep -o 'name="csrf_token" value="[^"]*"' \
  | sed 's/.*value="\([^"]*\)"/\1/')
[ -n "$csrf" ] || { echo "mcp-token: no consent form from /authorize (server down?)" >&2; exit 1; }

# POST /authorize — submit the form; a right login answers 302 to the redirect URI
# with the code. The password goes in on stdin (`password@-`), never on argv, so
# it can't surface in the process list.
location=$(printf '%s' "$MCP_SSH_PASS" | curl -sS -o /dev/null -w '%{http_code} %{redirect_url}' \
  -X POST "$BASE/authorize" \
  --data-urlencode "csrf_token=$csrf" \
  --data-urlencode "username=$MCP_SSH_USER" \
  --data-urlencode "password@-")
status=${location%% *}
location=${location#* }
code=$(printf '%s' "$location" | sed -n 's/.*[?&]code=\([^&]*\).*/\1/p')
if [ "$status" != 302 ] || [ -z "$code" ]; then
  echo "mcp-token: login refused (HTTP $status) — check MCP_SSH_USER/MCP_SSH_PASS" >&2
  exit 1
fi

# /token — exchange the code + PKCE verifier for an access token.
token=$(curl -fsS -X POST "$BASE/token" \
  --data-urlencode "grant_type=authorization_code" \
  --data-urlencode "code=$code" \
  --data-urlencode "code_verifier=$verifier" \
  --data-urlencode "redirect_uri=$REDIRECT" \
  --data-urlencode "client_id=$client_id" \
  | sed -n 's/.*"access_token":"\([^"]*\)".*/\1/p')
[ -n "$token" ] || { echo "mcp-token: token exchange failed" >&2; exit 1; }

printf '%s\n' "$token"
