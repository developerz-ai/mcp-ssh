#!/usr/bin/env python3
"""Regression guards for the bin/dev + bin/stop lifecycle: shutdown must never
target another checkout, and dev.lock must never wedge behind a descendant."""
import os
from pathlib import Path
import shutil
import signal
import subprocess
import tempfile
import time
import unittest

ROOT = Path(__file__).resolve().parent.parent


class DevLifecycle(unittest.TestCase):
    def test_checkout_isolation_and_stale_record(self):
        with tempfile.TemporaryDirectory() as tmp:
            base = Path(tmp)
            home = base / "home"
            cargo_bin = home / ".cargo/bin"
            cargo_bin.mkdir(parents=True)
            fake = cargo_bin / "cargo-watch"
            fake.write_text("#!/bin/sh\nsleep 300 &\necho $! > .local/child.pid\nwait\n")
            fake.chmod(0o755)
            shutil.copy2(fake, cargo_bin / "cargo")
            env = dict(os.environ, HOME=str(home))
            processes = []
            groups = []
            try:
                for name in ("first", "second"):
                    checkout = base / name
                    (checkout / "bin").mkdir(parents=True)
                    for script in ("dev", "stop"):
                        shutil.copy2(ROOT / "bin" / script, checkout / "bin" / script)
                    process = subprocess.Popen(
                        ["bash", "bin/dev"], cwd=checkout, env=env,
                        start_new_session=True,
                    )
                    processes.append(process)
                    record = checkout / ".local/dev.pid"
                    self.wait_for(lambda: record.exists(), "dev did not record its group")
                    pid, started = record.read_text().split()
                    groups.append(int(pid))
                    self.wait_for(lambda: (checkout / ".local/child.pid").exists(),
                                  "fake server did not start")
                first, second = base / "first", base / "second"
                # A second launcher must not replace the live group's identity.
                duplicate = subprocess.run(["bash", "bin/dev"], cwd=first, env=env)
                self.assertNotEqual(duplicate.returncode, 0)
                self.assertEqual(int((first / ".local/dev.pid").read_text().split()[0]),
                                 groups[0])
                subprocess.run(["bash", "bin/stop"], cwd=first, check=True)
                processes[0].wait(timeout=5)
                self.assertIsNone(processes[1].poll(), "other checkout was stopped")
                os.kill(groups[1], 0)
                child = int((first / ".local/child.pid").read_text())
                self.wait_for(lambda: self.dead(child), "server child survived shutdown")
                # A recycled PID with a mismatched birth time must not be signalled.
                (first / ".local/dev.pid").write_text(f"{groups[1]} 0\n")
                subprocess.run(["bash", "bin/stop"], cwd=first, check=True)
                self.assertIsNone(processes[1].poll())
                os.kill(groups[1], 0)
                subprocess.run(["bash", "bin/stop"], cwd=second, check=True)
                processes[1].wait(timeout=5)
                subprocess.run(["bash", "bin/stop"], cwd=second, check=True)
            finally:
                for group in groups + [p.pid for p in processes]:
                    try:
                        os.killpg(group, signal.SIGKILL)
                    except ProcessLookupError:
                        pass
                for process in processes:
                    process.wait(timeout=5)

    def test_detached_descendant_releases_lock(self):
        # A descendant that setsid's out of the dev group outlives a launcher
        # shutdown. It must not inherit lock FD 9, or it keeps dev.lock held
        # while dev.pid is gone and blocks every new bin/dev launch.
        with tempfile.TemporaryDirectory() as tmp:
            base = Path(tmp)
            home = base / "home"
            cargo_bin = home / ".cargo/bin"
            cargo_bin.mkdir(parents=True)
            fake = cargo_bin / "cargo-watch"
            fake.write_text(
                "#!/bin/sh\n"
                "setsid sleep 300 &\n"
                "echo $! > \".local/detached-$$.pid\"\n"
                "sleep 300 &\n"
                "echo $! > .local/child.pid\n"
                "wait\n"
            )
            fake.chmod(0o755)
            shutil.copy2(fake, cargo_bin / "cargo")
            env = dict(os.environ, HOME=str(home))
            checkout = base / "checkout"
            (checkout / "bin").mkdir(parents=True)
            for script in ("dev", "stop"):
                shutil.copy2(ROOT / "bin" / script, checkout / "bin" / script)
            record = checkout / ".local/dev.pid"
            launcher = subprocess.Popen(
                ["bash", "bin/dev"], cwd=checkout, env=env,
                start_new_session=True,
            )
            second = None
            detached_pids = []
            try:
                self.wait_for(lambda: record.exists(), "dev did not record its group")
                first_group = int(record.read_text().split()[0])
                self.wait_for(
                    lambda: bool(detached_pids or list(checkout.glob(".local/detached-*.pid"))),
                    "fake workload did not spawn a detached descendant",
                )
                if not detached_pids:
                    detached_pids.append(
                        int(next(checkout.glob(".local/detached-*.pid")).read_text()))
                # TERM only the launcher: its trap kills the dev group, while
                # the setsid'd descendant escapes it.
                launcher.send_signal(signal.SIGTERM)
                launcher.wait(timeout=5)
                self.wait_for(lambda: not record.exists(),
                              "dev.pid survived the launcher")
                self.assertFalse(self.dead(detached_pids[0]),
                                 "descendant did not outlive the shutdown")
                # The survivor must not hold dev.lock: a new launcher starts
                # even though the detached descendant is still alive.
                second = subprocess.Popen(
                    ["bash", "bin/dev"], cwd=checkout, env=env,
                    start_new_session=True,
                )
                self.wait_for(
                    lambda: record.exists()
                    and int(record.read_text().split()[0]) != first_group,
                    "surviving detached descendant kept dev.lock held",
                )
            finally:
                for pid_file in checkout.glob(".local/detached-*.pid"):
                    try:
                        detached_pids.append(int(pid_file.read_text()))
                    except ValueError:
                        pass
                for group in (launcher.pid, second.pid if second else None):
                    if group is None:
                        continue
                    try:
                        os.killpg(group, signal.SIGKILL)
                    except ProcessLookupError:
                        pass
                for pid in detached_pids:
                    try:
                        os.kill(pid, signal.SIGKILL)
                    except ProcessLookupError:
                        pass
                for process in (launcher, second):
                    if process is not None:
                        process.wait(timeout=5)

    @staticmethod
    def dead(pid):
        try:
            return Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[0] == "Z"
        except FileNotFoundError:
            return True

    def wait_for(self, predicate, message):
        deadline = time.monotonic() + 5
        while time.monotonic() < deadline:
            if predicate():
                return
            time.sleep(0.02)
        self.fail(message)


if __name__ == "__main__":
    unittest.main()
