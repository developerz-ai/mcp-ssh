#!/usr/bin/env bash
# Stop only the process group published by this checkout's bin/dev.
set -euo pipefail
cd "$(dirname "$0")/.."

[[ -r .local/dev.pid ]] || exit 0
read -r pid started < .local/dev.pid || exit 0
[[ "$pid" =~ ^[0-9]+$ && "$started" =~ ^[0-9]+$ ]] || exit 0
(( pid > 1 )) || exit 0
[[ -r /proc/$pid/stat ]] || exit 0
stat=$(< "/proc/$pid/stat")
read -ra fields <<< "${stat##*) }"
# Require the original process, still leading its private group and session.
[[ "${fields[19]:-}" == "$started" && "${fields[2]:-}" == "$pid" &&
   "${fields[3]:-}" == "$pid" ]] || exit 0
kill -TERM -- "-$pid" 2>/dev/null || true
