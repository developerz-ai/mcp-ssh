#!/usr/bin/env bash
# one-command stop, run by developerz.ai when a session ends — established by dz-runner setup mode. One command; adjust as the repo grows.
set -euo pipefail
cd "$(dirname "$0")/.."
pkill -f '[t]arget/debug/mcp-ssh serve' || true; pkill -f '[c]argo watch -x run -- serve' || true; pkill -f '[c]argo run -- serve' || true
