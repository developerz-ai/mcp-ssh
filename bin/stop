#!/usr/bin/env bash
# one-command stop, run by developerz.ai when a session ends — established by dz-runner setup mode. One command; adjust as the repo grows.
set -euo pipefail
cd "$(dirname "$0")/.."
pkill -f 'target/[d]ebug/mcp-ssh serve' 2>/dev/null || true; pkill -f 'target/[r]elease/mcp-ssh serve' 2>/dev/null || true; exit 0
