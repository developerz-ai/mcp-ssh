#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

if [ -f .env ]; then
  set -a
  # shellcheck disable=SC1091
  . ./.env
  set +a
fi

# Dev state (DB, job logs — see .env.example) and the pid bin/stop targets.
mkdir -p .local
# `exec` keeps this pid: the cargo tree — or, once `cargo run` execs the built
# binary in place, the server itself — that bin/stop tears down.
echo $$ > .local/dev.pid

if command -v cargo-watch >/dev/null 2>&1; then
  exec cargo watch -x 'run -- serve'
else
  exec cargo run -- serve
fi
