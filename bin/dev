#!/usr/bin/env bash
set -euo pipefail

# The cargo package lives in apps/mcp-ssh.
cd "$(dirname "$0")/../apps/mcp-ssh"

# .env lives next to the app (see .env.example); older checkouts keep one at the repo root.
if [ -f .env ]; then
  set -a
  # shellcheck disable=SC1091
  . ./.env
  set +a
elif [ -f ../../.env ]; then
  set -a
  # shellcheck disable=SC1091
  . ../../.env
  set +a
fi

# Dev state (DB, job logs — see .env.example) and the pid bin/stop targets.
mkdir -p .local
# `exec` keeps this pid: the cargo tree — or, once `cargo run` execs the built
# binary in place, the server itself — that bin/stop tears down.
echo $$ > .local/dev.pid

if command -v cargo-watch >/dev/null 2>&1; then
  exec cargo watch -x 'run -- serve'
else
  exec cargo run -- serve
fi
