# Obtain certs first:
#   certbot --nginx -d your-host.example.com

# Throttle the login endpoints per client IP: the server delegates rate
# limiting to the proxy. 10 r/m with a small burst is ample for humans and
# MCP clients, and slows password guessing on /authorize. (http context)
limit_req_zone $binary_remote_addr zone=mcp_ssh_auth:10m rate=10r/m;

# Catch-all: requests for any other Host never reach mcp-ssh.
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    server_name your-host.example.com;

    ssl_certificate     /etc/letsencrypt/live/your-host.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-host.example.com/privkey.pem;

    # Tool calls carry file content; keep bodies bounded.
    client_max_body_size 16m;

    location ~ ^/(authorize|token|register)$ {
        limit_req zone=mcp_ssh_auth burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:1337;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:1337;

        # Required for MCP SSE / streaming responses.
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name your-host.example.com;
    return 301 https://$host$request_uri;
}
